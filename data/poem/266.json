{"no":266,"title":"清庙","chapter":"周颂","section":"清庙之什","lines":[{"text":"于穆清庙，肃雍显相。济济多士，秉文之德。对越在天，骏奔走在庙。不显不承，无射于人斯。","chars":[{"c":"于","tone":"2","pinyin":"yú","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"穆","tone":"!","pinyin":"mù","pinyin_alt":null,"note":"","rusheng":true,"rhyme":false,"clause_end":false},{"c":"清","tone":"1","pinyin":"qīng","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"庙","tone":"4","pinyin":"miào","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":true},{"c":"肃","tone":"!","pinyin":"sù","pinyin_alt":null,"note":"","rusheng":true,"rhyme":false,"clause_end":false},{"c":"雍","tone":"1","pinyin":"yōng","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"显","tone":"3","pinyin":"xiǎn","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"相","tone":"4","pinyin":"xiàng","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":true},{"c":"济","tone":"3","pinyin":"jǐ","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"济","tone":"3","pinyin":"jǐ","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"多","tone":"1","pinyin":"duō","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"士","tone":"4","pinyin":"shì","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":true},{"c":"秉","tone":"3","pinyin":"bǐng","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"文","tone":"2","pinyin":"wén","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"之","tone":"1","pinyin":"zhī","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"德","tone":"!","pinyin":"dé","pinyin_alt":null,"note":"","rusheng":true,"rhyme":false,"clause_end":true},{"c":"对","tone":"4","pinyin":"duì","pinyin_alt":null,"note":"","rusheng"