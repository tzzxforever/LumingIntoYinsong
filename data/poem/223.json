{"no":223,"title":"角弓","chapter":"小雅","section":"鱼藻之什","lines":[{"text":"骍骍角弓，翩其反矣。兄弟婚姻，无胥远矣。","chars":[{"c":"骍","tone":"1","pinyin":"xīng","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"骍","tone":"1","pinyin":"xīng","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"角","tone":"!","pinyin":"jiǎo","pinyin_alt":null,"note":"","rusheng":true,"rhyme":false,"clause_end":false},{"c":"弓","tone":"1","pinyin":"gōng","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":true},{"c":"翩","tone":"1","pinyin":"piān","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"其","tone":"2","pinyin":"qí","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"反","tone":"3","pinyin":"fǎn","pinyin_alt":null,"note":"","rusheng":false,"rhyme":true,"clause_end":false},{"c":"矣","tone":"3","pinyin":"yǐ","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":true},{"c":"兄","tone":"1","pinyin":"xiōng","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"弟","tone":"4","pinyin":"dì","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"婚","tone":"1","pinyin":"hūn","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"姻","tone":"1","pinyin":"yīn","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":true},{"c":"无","tone":"2","pinyin":"wú","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"胥","tone":"1","pinyin":"xū","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"远","tone":"3","pinyin":"yuǎn","pinyin_alt":null,"note":"","rusheng":false,"rhyme":true,"clause_end":false},{"c":"矣","tone":"3","pinyin":"yǐ","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":true}]},{"text":"尔之远矣，民胥然矣。尔之教矣，民胥效矣。","chars":[{"c":"尔","tone":"3","pinyin":"ěr","pinyin_alt":null