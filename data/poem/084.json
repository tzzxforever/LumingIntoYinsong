{"no":84,"title":"山有扶苏","chapter":"国风","section":"郑风","lines":[{"text":"山有扶苏，隰有荷华。不见子都，乃见狂且。","chars":[{"c":"山","tone":"1","pinyin":"shān","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"有","tone":"3","pinyin":"yǒu","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"扶","tone":"2","pinyin":"fú","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"苏","tone":"1","pinyin":"sū","pinyin_alt":null,"note":"","rusheng":false,"rhyme":true,"clause_end":true},{"c":"隰","tone":"!","pinyin":"xí","pinyin_alt":null,"note":"","rusheng":true,"rhyme":false,"clause_end":false},{"c":"有","tone":"3","pinyin":"yǒu","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"荷","tone":"2","pinyin":"hé","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"华","tone":"2","pinyin":"huá","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":true},{"c":"不","tone":"!","pinyin":"bù","pinyin_alt":null,"note":"","rusheng":true,"rhyme":false,"clause_end":false},{"c":"见","tone":"4","pinyin":"jiàn","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"子","tone":"3","pinyin":"zǐ","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"都","tone":"1","pinyin":"dōu","pinyin_alt":null,"note":"","rusheng":false,"rhyme":true,"clause_end":true},{"c":"乃","tone":"3","pinyin":"nǎi","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"见","tone":"4","pinyin":"jiàn","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"狂","tone":"2","pinyin":"kuáng","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"且","tone":"3","pinyin":"qiě","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":true}]},{"text":"山有乔松，隰有游龙，不见子充，乃见狡童。","chars":[{"c":"山","tone":"1","pinyin":"shān","pinyin_alt":null,"n