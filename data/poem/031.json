{"no":31,"title":"击鼓","chapter":"国风","section":"邶风","lines":[{"text":"击鼓其镗，踊跃用兵。土国城漕，我独南行。","chars":[{"c":"击","tone":"!","pinyin":"jī","pinyin_alt":null,"note":"","rusheng":true,"rhyme":false,"clause_end":false},{"c":"鼓","tone":"3","pinyin":"gǔ","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"其","tone":"2","pinyin":"qí","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"镗","tone":"1","pinyin":"tāng","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":true},{"c":"踊","tone":"3","pinyin":"yǒng","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"跃","tone":"!","pinyin":"yuè","pinyin_alt":null,"note":"","rusheng":true,"rhyme":false,"clause_end":false},{"c":"用","tone":"4","pinyin":"yòng","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"兵","tone":"1","pinyin":"bīng","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":true},{"c":"土","tone":"3","pinyin":"tǔ","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"国","tone":"!","pinyin":"guó","pinyin_alt":null,"note":"","rusheng":true,"rhyme":false,"clause_end":false},{"c":"城","tone":"2","pinyin":"chéng","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"漕","tone":"2","pinyin":"cáo","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":true},{"c":"我","tone":"3","pinyin":"wǒ","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"独","tone":"!","pinyin":"dú","pinyin_alt":null,"note":"","rusheng":true,"rhyme":false,"clause_end":false},{"c":"南","tone":"2","pinyin":"nán","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"行","tone":"2","pinyin":"xíng","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":true}]},{"text":"从孙子仲，平陈与宋。不我以归，忧心有忡。","chars":[{"c":"从","tone":"2","pinyin":"cóng","pinyin_alt":null,"n