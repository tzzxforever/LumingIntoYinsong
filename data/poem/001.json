{"no":1,"title":"关雎","chapter":"国风","section":"周南","lines":[{"text":"关关雎鸠，在河之洲。窈窕淑女，君子好逑。","chars":[{"c":"关","tone":"1","pinyin":"guān","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"关","tone":"1","pinyin":"guān","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"雎","tone":"1","pinyin":"jū","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"鸠","tone":"1","pinyin":"jiū","pinyin_alt":null,"note":"","rusheng":false,"rhyme":true,"clause_end":true},{"c":"在","tone":"4","pinyin":"zài","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"河","tone":"2","pinyin":"hé","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"之","tone":"1","pinyin":"zhī","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"洲","tone":"1","pinyin":"zhōu","pinyin_alt":null,"note":"","rusheng":false,"rhyme":true,"clause_end":true},{"c":"窈","tone":"3","pinyin":"yǎo","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"窕","tone":"3","pinyin":"tiǎo","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"淑","tone":"!","pinyin":"shū","pinyin_alt":null,"note":"","rusheng":true,"rhyme":false,"clause_end":false},{"c":"女","tone":"3","pinyin":"nǚ","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":true},{"c":"君","tone":"1","pinyin":"jūn","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"子","tone":"3","pinyin":"zǐ","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"好","tone":"3","pinyin":"hǎo","pinyin_alt":"hào","note":"美好","rusheng":false,"rhyme":false,"clause_end":false},{"c":"逑","tone":"2","pinyin":"qiú","pinyin_alt":null,"note":"","rusheng":false,"rhyme":true,"clause_end":true}]},{"text":"参差荇菜，左右流之。窈窕淑女，寤寐求之。","chars":[{"c":"参","tone":"1","pinyin":"cān","pinyin_alt":null,"n