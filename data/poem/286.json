{"no":286,"title":"闵予小子","chapter":"周颂","section":"闵予小子之什","lines":[{"text":"闵予小子，遭家不造，嬛嬛在疚。于乎皇考，永世克孝。","chars":[{"c":"闵","tone":"3","pinyin":"mǐn","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"予","tone":"3","pinyin":"yǔ","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"小","tone":"3","pinyin":"xiǎo","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"子","tone":"3","pinyin":"zǐ","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":true},{"c":"遭","tone":"1","pinyin":"zāo","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"家","tone":"1","pinyin":"jiā","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"不","tone":"!","pinyin":"bù","pinyin_alt":null,"note":"","rusheng":true,"rhyme":false,"clause_end":false},{"c":"造","tone":"4","pinyin":"zào","pinyin_alt":null,"note":"","rusheng":false,"rhyme":true,"clause_end":true},{"c":"嬛","tone":"2","pinyin":"huán","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"嬛","tone":"2","pinyin":"huán","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"在","tone":"4","pinyin":"zài","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"疚","tone":"4","pinyin":"jiù","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":true},{"c":"于","tone":"2","pinyin":"yú","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"乎","tone":"1","pinyin":"hū","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"皇","tone":"2","pinyin":"huáng","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":false},{"c":"考","tone":"3","pinyin":"kǎo","pinyin_alt":null,"note":"","rusheng":false,"rhyme":false,"clause_end":true},{"c":"永","tone":"3","pinyin":"yǒng","pinyin_alt":null,"note":"","rusheng":false,"rhym